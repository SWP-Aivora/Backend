ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=aivora;Username=postgres;Password=your_password
JwtSettings__Secret=Your_Super_Secret_Key_At_Least_32_Chars_Long
JwtSettings__Issuer=AivoraApi
JwtSettings__Audience=AivoraClient
JwtSettings__ExpiryInMinutes=1440
CloudinaryOptions__CloudName=your_cloud_name
CloudinaryOptions__ApiKey=your_api_key
CloudinaryOptions__ApiSecret=your_api_secret

# AI provider
# Development can keep Mock. Production must use Gemini with fallback disabled.
AIProvider__Provider=Mock
AIProvider__ApiKey=
AIProvider__BaseUrl=https://generativelanguage.googleapis.com
AIProvider__Model=gemini-2.5-flash
AIProvider__EnableFallback=true


# VNPay Sandbox (test keys - for development only)
VNPay__TmnCode=BIVWVEYB
VNPay__HashSecret=B4IEDEG7MNWFS3OGH87GEFX1KVHBII6O
VNPay__BaseUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPay__ReturnUrl=https://localhost:5000/api/v1/wallet/vnpay-return
VNPay__IpnUrl=https://localhost:5000/api/v1/wallet/vnpay-ipn

# Rate limiting
RateLimit__Strict__PermitLimit=10
RateLimit__Strict__WindowInMinutes=1
RateLimit__AI__PermitLimit=20
RateLimit__AI__WindowInMinutes=1
RateLimit__General__PermitLimit=100
RateLimit__General__WindowInMinutes=1
